# Copy to .env and fill in. Names only here; never commit values.
# One .env per client install. CLIENT_ID must match a file in clients/.
CLIENT_ID=example

# Airtable: personal access token with scopes data.records:read,
# data.records:write, schema.bases:read, schema.bases:write.
AIRTABLE_PAT=
AIRTABLE_WORKSPACE_ID=
# Left blank until `python -m engine.provision` prints it.
AIRTABLE_BASE_ID=

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

TREG_API_KEY=
TREG_RUN_BUDGET_USD=2
TREG_MONTHLY_BUDGET_USD=150

HUNTER_API_KEY=
HUBSPOT_SERVICE_KEY=

GOJIBERRY_ENABLED=false
GOJIBERRY_API_KEY=
GOJIBERRY_WEBHOOK_SECRET=
GOJIBERRY_LIST_IDS=

SENDER_DAILY_INVITE_CAP=15
SENDER_WEEKLY_INVITE_CAP=100
ACCEPTANCE_PAUSE_THRESHOLD=0.20
TZ=America/Chicago

OFFER_SETUP_PRICE=
OFFER_MONTHLY_PRICE=
BOOKING_URL=
